    "from sklearn.metrics import r2_score\n",
    "\n",
    "actual = [100, 200, 300]\n",
    "\n",
    "predicted = [110, 190, 280]\n",
    "\n",
    "r2 = r2_score(\n",
    "    actual,\n",
    "    predicted\n",
    ")\n",
    "\n",
    "print(\"R² Score:\", r2)"
